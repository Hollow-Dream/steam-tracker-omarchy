[Unit]
Description=Run Steam Sale Tracker every 30 minutes

[Timer]
# Runs on a fixed cadence but staggers slightly to avoid every Omarchy
# install hitting Steam's API at the exact same second.
OnBootSec=5min
OnUnitActiveSec=30min
RandomizedDelaySec=90
Persistent=true

[Install]
WantedBy=timers.target
